generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Revenue {
  id        Int      @id @default(autoincrement())
  period    String
  year      Int
  quarter   Int
  amount    Decimal  @db.Decimal(15, 2)
  category  String
  createdAt DateTime @default(now())
}

model Expense {
  id        Int      @id @default(autoincrement())
  period    String
  year      Int
  quarter   Int
  amount    Decimal  @db.Decimal(15, 2)
  category  String
  createdAt DateTime @default(now())
}

model Client {
  id             Int      @id @default(autoincrement())
  name           String
  segment        String
  portfolioValue Decimal  @db.Decimal(15, 2)
  status         String
  joinDate       DateTime
  createdAt      DateTime @default(now())
}

model FinancialIndicator {
  id        Int      @id @default(autoincrement())
  name      String
  value     Decimal  @db.Decimal(10, 4)
  period    String
  year      Int
  quarter   Int
  createdAt DateTime @default(now())
}

model sabana_tdc_riesgos {
  clienteid              Int?
  edad                   Int?
  genero                 String?  @db.VarChar(1)
  estadocivil            String?  @db.VarChar(20)
  nivelsocioeconomico    String?  @db.VarChar(5)
  ingresomensual         Decimal? @db.Decimal(14, 2)
  tipoempleo             String?  @db.VarChar(20)
  antiguedadlaboralmeses Int?
  scoreinternoinicial    Int?
  scoreexternoinicial    Int?
  segmentocliente        String?  @db.VarChar(20)
  tarjetaid              BigInt
  tipotarjeta            String?  @db.VarChar(20)
  marcatarjeta           String?  @db.VarChar(20)
  lineacreditoasignada   Decimal? @db.Decimal(14, 2)
  canalcolocacion        String?  @db.VarChar(20)
  tasainteresanual       Decimal? @db.Decimal(6, 2)
  fec_alta               Int?
  mes                    Int
  dpd                    Int?
  cubetas                Int?
  montoenmora            Decimal? @db.Decimal(14, 2)
  pd                     Decimal? @db.Decimal(6, 2)
  lgd                    Decimal? @db.Decimal(6, 2)
  ead                    Decimal? @db.Decimal(14, 2)
  scoreinterno           Int?
  usomes                 Decimal? @db.Decimal(14, 2)
  pagomes                Decimal? @db.Decimal(14, 2)
  pagominimo             Decimal? @db.Decimal(14, 2)
  cubreminimo            Boolean?
  saldotarjeta           Decimal? @db.Decimal(14, 2)
  montocompraspos        Decimal? @db.Decimal(14, 2)
  montocomprasecommerce  Decimal? @db.Decimal(14, 2)
  montoretirosefectivo   Decimal? @db.Decimal(14, 2)
  rentabilidad           Decimal? @db.Decimal(14, 2)
  costoriesgo            Decimal? @db.Decimal(14, 2)

  @@id([tarjetaid, mes], map: "pk_sabana_tdc")
  @@index([clienteid], map: "idx_flat_cliente")
  @@index([cubetas], map: "idx_flat_cubetas")
  @@index([mes], map: "idx_flat_mes")
  @@index([segmentocliente], map: "idx_flat_segmento")
  @@index([tarjetaid], map: "idx_flat_tarjeta")
  @@index([tipotarjeta], map: "idx_flat_tipo_tarjeta")
}
